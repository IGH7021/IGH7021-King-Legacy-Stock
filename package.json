{
  "name": "igh7021-kinglegacy-stock",
  "version": "1.5.0",
  "private": true,
  "description": "King Legacy stock dashboard with a lightweight Node.js API",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/server.js",
    "migrate:supabase": "node scripts/migrate-supabase.js",
    "test": "node --test",
    "build": "npm run build:css",
    "build:css": "tailwindcss -c tailwind.config.cjs -i css/tailwind.input.css -o css/tailwind.generated.css --minify"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
