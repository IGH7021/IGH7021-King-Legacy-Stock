PORT=3000
APP_ORIGIN=http://localhost:3000

# Supabase project settings. Keep the service-role key server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DISABLED=false

# GitHub OAuth App settings for the single administrator account.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ADMIN_USERNAME=
GITHUB_OAUTH_STATE_SECRET=

# OAuth identity providers for users linking an access key to their account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=